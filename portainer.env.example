# API image published by GitHub Actions build #13.
GAMECOLLECTOR_API_IMAGE=dockerhub.buildserver.be/gamecollector-api:sha-c4c6ac040eddd8728532d53116dc2ec0d56e9663

# Keycloak
KEYCLOAK_AUTHORITY=https://sso.buildserver.be/realms/Buildserver
KEYCLOAK_AUDIENCE=gamecollector-api
KEYCLOAK_ADMIN_ROLE=gamecollector-admin

# MinIO - replace both CHANGE_ME values before deployment.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=gamecollector-media
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Firebase Cloud Messaging for the API.
# Put firebase-service-account.json inside the host directory below.
# Do not use either Android google-services.json file here.
FIREBASE_PROJECT_ID=gamecollector-nevoka
FIREBASE_CREDENTIALS_HOST_DIRECTORY=/volume1/docker/gamecollector/gamecollector-api/firebase
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase/firebase-service-account.json

# API exposure. Keep loopback when a reverse proxy on the Docker host serves gc.lateur.pro.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# External catalog and API hardening
EXTERNAL_CATALOG_BASE_URL=https://api.upcitemdb.com/prod/trial/
EXTERNAL_CATALOG_TIMEOUT_SECONDS=5
EXTERNAL_CATALOG_CACHE_MINUTES=60
API_MAX_REQUEST_BYTES=10485760
API_RATE_LIMIT_PER_MINUTE=120
API_REQUEST_TIMEOUT_SECONDS=30
