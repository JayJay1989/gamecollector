{
  "ConnectionStrings": {
    "GameCollector": "Data Source=data/gamecollector.db;Foreign Keys=True;Default Timeout=5;Pooling=True"
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "https://sso.buildserver.be/realms/Buildserver",
      "Audience": "gamecollector-api",
      "AdminRole": "gamecollector-admin",
      "RequireHttpsMetadata": true
    }
  },
  "MediaStorage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "gamecollector",
    "SecretKey": "change-me",
    "Bucket": "gamecollector-media",
    "UseSsl": false
  },
  "ExternalCatalog": {
    "BaseUrl": "https://api.upcitemdb.com/prod/trial/",
    "TimeoutSeconds": 5,
    "CacheMinutes": 60
  },
  "Firebase": {
    "ProjectId": "",
    "CredentialsPath": null
  },
  "ApiHardening": {
    "MaximumRequestBodyBytes": 1048576,
    "RateLimitPermitCount": 120,
    "RateLimitWindowSeconds": 60,
    "RequestTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
